# ------------------------------------------------------------------
# Facebook access tokens (FB_PAGE_TOKEN is required)
# ------------------------------------------------------------------

# Page access token. This is the token Page tools act on. Get one from the
# Graph API Explorer or your app's access token tool. A long-lived token is
# strongly recommended; short-lived tokens expire in about 2 hours.
#
# Minimum scopes for the read tools:
#   pages_show_list, pages_read_engagement, read_insights
# Add for the write tools:
#   pages_manage_posts, pages_manage_engagement
FB_PAGE_TOKEN=your-page-access-token

# Optional User access token. It is used for edges that hang off a person
# rather than a Page: pages_list and pages_find (GET me/accounts).
# Leave empty to use FB_PAGE_TOKEN for those calls; that works when the Page
# token was issued through a person who holds pages_show_list.
# Needed scopes: pages_show_list
FB_USER_TOKEN=

# ------------------------------------------------------------------
# Graph API
# ------------------------------------------------------------------

# Graph API version used for every request. Accepts v27.0 or 27.0. A bare major
# such as v27 is rejected by the API. Set this to the version your Meta app was
# created on; a new app is created on the current version. See
# https://developers.facebook.com/docs/graph-api/changelog/versions/
# for the current version and its expiration date.
FB_GRAPH_VERSION=v27.0

# Base URL of the Graph API. Change only for a test double or a proxy.
FB_GRAPH_BASE_URL=https://graph.facebook.com

# Set to false only for a local test double that uses a self-signed
# certificate (not recommended).
FB_VERIFY_SSL=true

# HTTP timeout (seconds) for Graph API calls.
FB_TIMEOUT=30

# Extra retry attempts on transient Graph failures (HTTP 429/5xx and Graph
# error codes 1, 2, 4, 17, 32).
FB_MAX_RETRIES=2

# ------------------------------------------------------------------
# MCP server settings
# ------------------------------------------------------------------

# Bearer token clients must present to use THIS MCP server
# (required for `serve-http`; stdio does not need it).
# Generate one with: facebook-pages-mcp-server gen-key
# Multiple keys may be listed comma-separated.
MCP_API_KEY=

# Host/port for `serve-http` (default 127.0.0.1:8900).
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8900

# Comma-separated Host header allowlist for the HTTP transport.
# DNS-rebinding protection is auto-enabled for loopback hosts; add your
# real hostname here (and the matching origin) when serving publicly.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

# ------------------------------------------------------------------
# Tool permissions (which tools the AI can see and call)
# ------------------------------------------------------------------
#
# The tools the AI is given are gated by MCP_TOOL_PERMISSIONS, based on
# what each tool does to Facebook data:
#
#   read   - READ-ONLY tools. Fetch Pages, posts, comments, photos, videos,
#            events, conversations and Insights. Changes nothing. Safe.
#
#   write  - WRITE tools. Publish posts, comment on posts, upload photos and
#            videos (page_publish, post_comment_create, page_photo_publish,
#            page_video_publish, graph_write). The AI WILL publish to your
#            Page when it calls them.
#
#   delete - DELETE tools. Permanently remove posts and comments
#            (post_delete, comment_delete).
#
# !! WARNING !!
# !! Enabling 'delete' lets the AI PERMANENTLY DELETE posts and comments on
# !! your Page. Deletions cannot be undone. Enabling 'write' lets it publish
# !! publicly under your Page name. Consider a token scoped to a single test
# !! Page before enabling either.
#
# Combine levels with commas. Higher levels do NOT imply lower ones - list
# everything you want:
#
#   MCP_TOOL_PERMISSIONS=read                -> AI can only look at data
#   MCP_TOOL_PERMISSIONS=read,write          -> AI can look at AND publish
#   MCP_TOOL_PERMISSIONS=read,write,delete   -> AI has full control (dangerous)
#
# If left empty/unset, the server defaults to read-only.
# Unknown values (typos) make the server refuse to start.
MCP_TOOL_PERMISSIONS=read

# Logging: DEBUG, INFO, WARNING, ERROR
MCP_LOG_LEVEL=INFO
